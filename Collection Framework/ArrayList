import java.util.ArrayList;
public class ArrayListDemo {
    public static void main(String[] args){
        ArrayList<Integer> list =new ArrayList<>();
        list.add(10);
        list.add(20);
        list.add(30);
        System.out.println("ArrayList: " + list);
        
        System.out.println(list.get(0));
        list.set(1,50);
        
        System.out.println("ArrayList:"+list);
        
        list.remove(0);
        System.out.println(" After removing ArrayList:"+list);
        
        System.out.println("Size of ArrayList:"+list.size());
        System.out.println("to check 30:"+list.contains(30));
        
        list.remove(Integer.valueOf(30));
        System.out.println("After removing 30:"+list);
        System.out.println("To check is list empty"+list.isEmpty());

        System.out.println(list);

        list.remove(Integer.valueOf(50));

        System.out.println(list);

        list.add(100);
        list.add(200);
        list.add(100);
        
        System.out.println("The elements are:"+list);

        System.out.println("The first index is:"+list.indexOf(100));
        System.out.println("the last index is:"+list.lastIndexOf(100));

        ArrayList<Integer> list2= new ArrayList<>();
        list2.add(500);
        list2.add(600);

        list.addAll(list2);
        System.out.println("The elements are:"+list);

        list.removeAll(list2);
        System.out.println(list);
        
        //enhanced for loop
        for(int x: list){
            System.out.println(x);
        }
        //to convert list to array
        Object [] arr= list.toArray();

        for(Object x:arr){
            System.out.println(x);
        }

        list.clear();

        System.out.println(list);






       }
}
